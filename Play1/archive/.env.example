# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# Local dev quickstart (PAT auth, stdio transport):
#   MCP_TRANSPORT=stdio  TABLEAU_AUTH=pat  + the TABLEAU_PAT_* values below.

# --- Where the server listens / how clients reach it ---
MCP_TRANSPORT=stdio          # "stdio" for local dev; "http" for hosted (Copilot Studio)
PORT=8000                    # HTTP transport port (ignored for stdio)
# MCP_API_KEY=change-me       # if set (http), callers must send Authorization: Bearer <key>

# --- Tableau site ---
TABLEAU_SERVER=https://10ax.online.tableau.com
TABLEAU_SITE=your-site-content-url
TABLEAU_AUTH=jwt             # "jwt" (Connected App, recommended for hosting) or "pat"

# --- Connected App (Direct Trust) JWT auth — recommended for hosted deployments ---
TABLEAU_CONNECTED_APP_CLIENT_ID=
TABLEAU_CONNECTED_APP_SECRET_ID=
TABLEAU_CONNECTED_APP_SECRET_VALUE=
TABLEAU_JWT_USERNAME=        # Tableau user to act as; a Site Admin sees all rows (bypasses RLS)

# --- Personal Access Token auth — simplest for local dev (TABLEAU_AUTH=pat) ---
TABLEAU_PAT_NAME=
TABLEAU_PAT_VALUE=
