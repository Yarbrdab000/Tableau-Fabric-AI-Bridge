		expression 'DirectQuery to AS - Meta_data_semantic_Model' =
				let
				    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Ultrastore_Fabric", "Meta_data_semantic_Model"),
				    Cubes = Table.Combine(Source[Data]),
				    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
				in
