{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "6548271604019113871"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group location."
      }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "tableau-mcp",
      "metadata": {
        "description": "Name for the Container App (also used as the public subdomain)."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/yarbrdab000/tableau-fabric-ai-bridge-mcp:latest",
      "metadata": {
        "description": "Container image to run. Publish your own or use a prebuilt image."
      }
    },
    "tableauServer": {
      "type": "string",
      "metadata": {
        "description": "Tableau server/pod URL, e.g. https://10ay.online.tableau.com"
      }
    },
    "tableauSite": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tableau site content URL (the slug in the site URL). Empty = Default site."
      }
    },
    "tableauAuth": {
      "type": "string",
      "defaultValue": "jwt",
      "allowedValues": [
        "jwt",
        "pat"
      ],
      "metadata": {
        "description": "Tableau auth mode for the server: jwt (Connected App, recommended) or pat."
      }
    },
    "connectedAppClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Connected App client ID (Tableau > Settings > Connected Apps)."
      }
    },
    "connectedAppSecretId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Connected App secret ID (a non-sensitive identifier shown in Tableau next to the client ID; the secret VALUE is the sensitive one)."
      }
    },
    "connectedAppSecretValue": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Connected App secret value."
      }
    },
    "jwtUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tableau username the server acts as (a Site Admin sees all rows / bypasses RLS)."
      }
    },
    "patName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "PAT name (only if tableauAuth = pat)."
      }
    },
    "patValue": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "PAT secret value (only if tableauAuth = pat)."
      }
    },
    "mcpApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Shared API key callers must present as \"Authorization: Bearer <key>\" or the \"x-api-key\" header. Required so your deployed endpoint is not publicly open. Invent a long random string (e.g. a GUID)."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 5,
      "metadata": {
        "description": "Minimum replicas. 0 enables scale-to-zero (near-zero idle cost)."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Maximum replicas."
      }
    }
  },
  "variables": {
    "logName": "[format('{0}-logs', parameters('containerAppName'))]",
    "envName": "[format('{0}-env', parameters('containerAppName'))]",
    "secretsArray": "[concat(createArray(createObject('name', 'mcp-api-key', 'value', parameters('mcpApiKey'))), if(empty(parameters('connectedAppSecretValue')), createArray(), createArray(createObject('name', 'connected-app-secret-value', 'value', parameters('connectedAppSecretValue')))), if(empty(parameters('patValue')), createArray(), createArray(createObject('name', 'pat-value', 'value', parameters('patValue')))))]",
    "baseEnv": [
      {
        "name": "MCP_TRANSPORT",
        "value": "http"
      },
      {
        "name": "PORT",
        "value": "8000"
      },
      {
        "name": "TABLEAU_SERVER",
        "value": "[parameters('tableauServer')]"
      },
      {
        "name": "TABLEAU_SITE",
        "value": "[parameters('tableauSite')]"
      },
      {
        "name": "TABLEAU_AUTH",
        "value": "[parameters('tableauAuth')]"
      },
      {
        "name": "TABLEAU_CONNECTED_APP_CLIENT_ID",
        "value": "[parameters('connectedAppClientId')]"
      },
      {
        "name": "TABLEAU_CONNECTED_APP_SECRET_ID",
        "value": "[parameters('connectedAppSecretId')]"
      },
      {
        "name": "TABLEAU_JWT_USERNAME",
        "value": "[parameters('jwtUsername')]"
      },
      {
        "name": "TABLEAU_PAT_NAME",
        "value": "[parameters('patName')]"
      },
      {
        "name": "MCP_API_KEY",
        "secretRef": "mcp-api-key"
      }
    ],
    "containerEnv": "[concat(variables('baseEnv'), if(empty(parameters('connectedAppSecretValue')), createArray(), createArray(createObject('name', 'TABLEAU_CONNECTED_APP_SECRET_VALUE', 'secretRef', 'connected-app-secret-value'))), if(empty(parameters('patValue')), createArray(), createArray(createObject('name', 'TABLEAU_PAT_VALUE', 'secretRef', 'pat-value'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[variables('secretsArray')]"
        },
        "template": {
          "containers": [
            {
              "name": "mcp",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": "[variables('containerEnv')]",
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8000
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-scale",
                "http": {
                  "metadata": {
                    "concurrentRequests": "20"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]"
      ]
    }
  ],
  "outputs": {
    "mcpBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "The public base URL of the deployed MCP server."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "mcpEndpoint": {
      "type": "string",
      "metadata": {
        "description": "The MCP endpoint to register in Copilot Studio (Streamable HTTP)."
      },
      "value": "[format('https://{0}/mcp', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "healthUrl": {
      "type": "string",
      "metadata": {
        "description": "Health check URL."
      },
      "value": "[format('https://{0}/healthz', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    }
  }
}